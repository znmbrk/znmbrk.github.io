---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props as Props;

// The back link points one level up: /bookshelf/x -> /bookshelf, /blog -> home.
const segments = Astro.url.pathname.split('/').filter(Boolean);
const back = segments.length === 0
  ? null
  : segments.length === 1
    ? { href: '/', label: 'home' }
    : { href: '/' + segments.slice(0, -1).join('/'), label: segments[segments.length - 2] };
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Zain Mobarik - Personal Website" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QFQ9D4XNM6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-QFQ9D4XNM6');
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>

    <footer class="site-footer">
      {back ? <a href={back.href}>← {back.label}</a> : <span></span>}
      <a href="https://cal.com/zain-mobarik-4tdyos/website" target="_blank"><em>say hi</em></a>
    </footer>
  </body>
</html>